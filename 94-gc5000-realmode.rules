# Lock the real pad to root: only the FF proxy daemon (root) may open it.
# Steam Input and games should only ever see the FF proxy.
# Mode bits alone are not enough: logind's uaccess mechanism grants the
# seated user an ACL that overrides root-only permissions; the daemon
# strips those ACLs at startup (see gc5000_ffd.py, strip_user_acls).
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Nokia GC 5000", MODE="0600", OWNER="root", GROUP="root"
ACTION=="add", SUBSYSTEM=="input", KERNEL=="js*", ATTRS{name}=="Nokia GC 5000", MODE="0600", OWNER="root", GROUP="root"
ACTION=="add", SUBSYSTEM=="hidraw", KERNEL=="hidraw*", KERNELS=="0005:1D5A:1802.*", MODE="0600", OWNER="root", GROUP="root"
